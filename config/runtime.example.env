# Runtime configuration template. Copy to `.env` (gitignored) and fill in.
#
#   cp config/runtime.example.env .env
#
# Nothing environment-specific is hardcoded in the code. Never commit the filled-in file.
# Authentication is Microsoft Entra ID: Azure CLI locally, managed identity on Azure.

# --- Authentication -------------------------------------------------------------
# Local: cli (uses `az`, pinned to the subscription below). Azure Container Apps: managed_identity.
TMAP_AUTH_MODE=cli
# Required for cli mode. The implicit az default subscription is never used.
TMAP_POC_AZ_SUBSCRIPTION=<your-subscription-name-or-id>
# Optional path to the Azure CLI. Under WSL the Linux CLI (~/.local/bin/az) is preferred over the Windows one.
TMAP_AZ_BINARY=
# Only for a user-assigned managed identity (managed_identity mode).
AZURE_CLIENT_ID=

# --- Foundry project and agents ------------------------------------------------
# Foundry project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
GWB_PROJECT_ENDPOINT=
# Model deployment used by `tmap prepare-agents` and `tmap compare` (same model for both agents).
TMAP_POC_MODEL_DEPLOYMENT=
# Project connections attached to the agents: Grounding with Bing resource and WebIQ key.
# `scripts/setup_webiq_connection.py` creates the WebIQ connection from WEBIQ_API_KEY.
GWB_CONNECTION_ID=
WEBIQ_CONNECTION_ID=
WEBIQ_API_KEY=
# Agents printed by `uv run tmap prepare-agents --apply`. Pin the versions.
TMAP_BING_AGENT_NAME=
TMAP_BING_AGENT_VERSION=
TMAP_WEBIQ_AGENT_NAME=
TMAP_WEBIQ_AGENT_VERSION=

# --- Voice Live ------------------------------------------------------------------
# Root endpoint of a Foundry resource in a Voice Live region: https://<resource>.cognitiveservices.azure.com
TMAP_VOICE_ENDPOINT=
TMAP_VOICE_NAME=ko-KR-SunHiNeural
# Set when the agents' Foundry resource differs from the Voice Live resource.
TMAP_VOICE_FOUNDRY_RESOURCE_OVERRIDE=
TMAP_VOICE_AGENT_IDENTITY_CLIENT_ID=
# End-to-end mode, Bing lane: Foundry Toolbox holding the Bing-based `web_search` tool.
# Empty = the Bing lane falls back to calling the Bing Agent. See docs/DEPLOYMENT.md.
TMAP_WEB_SEARCH_TOOLBOX=

# --- Web app -----------------------------------------------------------------------
# Exact browser origins allowed to open the voice WebSocket (no wildcards).
TMAP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Tracing (optional) ----------------------------------------------------------
# console (local metadata), none, foundry (project's Application Insights connection) or azure.
# Prompts, tool arguments, raw results and audio are never exported.
TMAP_TRACE_EXPORTER=console
# Only for azure mode; install with `uv sync --extra azure-tracing`.
APPLICATIONINSIGHTS_CONNECTION_STRING=
