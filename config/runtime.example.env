# Runtime configuration template.
# Copy to `.env` (gitignored) and fill in. Never commit the filled-in file.
#
#   cp config/runtime.example.env .env
#
# Authentication uses Entra ID (`az account get-access-token`) at runtime.
# No API key is stored anywhere. The target resource has local auth disabled.

# --- Model under test (identical across all search paths) ---
TMAP_POC_MODEL_ENDPOINT=https://<your-aiservices-resource>.cognitiveservices.azure.com
TMAP_POC_MODEL_DEPLOYMENT=<your-deployment-name>
TMAP_POC_MODEL_API_VERSION=2025-01-01-preview

# Azure CLI subscription to mint tokens against.
# Leave blank to use the current `az` default context.
# NOTE: verify this is the intended subscription before every run.
TMAP_POC_AZ_SUBSCRIPTION=<your-subscription-name-or-id>

# --- Search layer credentials (fill in as each path is secured) ---
WEBIQ_API_KEY=
EXA_API_KEY=
GWB_PROJECT_ENDPOINT=
GWB_CONNECTION_ID=
